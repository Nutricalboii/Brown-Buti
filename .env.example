# ──────────────────────────────────────────────
# Shopify Storefront API
# ──────────────────────────────────────────────
VITE_SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_api_token_here

# ──────────────────────────────────────────────
# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
# VITE_ prefix exposes the Key ID to the frontend (safe — public key only)
# RAZORPAY_KEY_SECRET must NEVER be exposed to the frontend
# ──────────────────────────────────────────────
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Browser checkout is intentionally not used for the international USD path.
VITE_RAZORPAY_CHECKOUT_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ──────────────────────────────────────────────
# International USD Payment Links (server-side only)
# ──────────────────────────────────────────────
RAZORPAY_MODE=test
RAZORPAY_INTERNATIONAL_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# USD per order. DEFAULT is required; add approved ISO-2 country overrides.
INTERNATIONAL_SHIPPING_RATES_USD={"US":35,"GB":40,"DE":45,"JP":45,"DEFAULT":50}
PUBLIC_SITE_URL=https://brown-buti.vercel.app

# Shopify Admin token: server-side only, with write_orders permission.
SHOPIFY_ADMIN_STORE_DOMAIN=1fieuf-bz.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_token_here

# Supabase service-role credentials: server-side only for order state.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Shared server-side rate limiting (never use a VITE_ prefix for these values).
# Configure the same Upstash Redis credentials in local .env, Vercel, and Supabase.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
